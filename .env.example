# ==========================================
# Конфигурация discord-bot-hoshizune
# ==========================================

# Токен Discord бота и ID приложения (поддерживаются также CLIENT_ID и DISCORD_TOKEN)
DISCORD_APPLICATION_ID=your_client_id_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
DISCORD_TOKEN=your_discord_bot_token_here

# ------------------------------------------
# Конфигурация Базы Данных (PostgreSQL)
# ------------------------------------------
# Порт PostgreSQL на хост-машине (изменен на 2406 во избежание конфликтов)
POSTGRES_PORT=2406

# URL подключения к базе данных (PostgreSQL)
# Для работы локально без Docker используйте localhost:2406
DATABASE_URL="postgresql://postgres:postgres@localhost:2406/discord_bot_hoshizune?schema=public"

# Если используется запуск бота внутри Docker-контейнера:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/discord_bot_hoshizune?schema=public"

# ------------------------------------------
# Альтернатива: SQLite (для разработки без PostgreSQL)
# ------------------------------------------
# DATABASE_URL="file:./dev.db"
